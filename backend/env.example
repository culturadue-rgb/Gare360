# Copia questo file in .env per lo sviluppo locale.
# Su Render questi valori si impostano in Environment -> Environment Variables.

# Password condivisa per entrare nell'app. OBBLIGATORIA: senza, il backend
# risponde 503 a tutto e l'app resta bloccata (scelta voluta: meglio ferma che aperta).
APP_PASSWORD=

# Chiave per l'assistente AI.
ANTHROPIC_API_KEY=
STRATEGA_MODEL=claude-sonnet-4-6

# Siti autorizzati a parlare con questo backend, separati da virgola.
ALLOWED_ORIGINS=http://localhost:5173,https://gare360-ynfu.vercel.app

# Riammette TUTTE le anteprime *.vercel.app (indirizzo diverso a ogni
# pubblicazione). Lasciare 0: apre il backend a chiunque pubblichi su Vercel.
ANTEPRIME_VERCEL=0

# Mostra la documentazione automatica su /docs. Lasciare 0 in produzione:
# elenca tutti i comandi dell'API a chiunque apra l'indirizzo.
MOSTRA_DOCS=0
